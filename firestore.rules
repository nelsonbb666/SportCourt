rules_version = '2';

/**
 * ============================================================
 * Reglas de seguridad de Cloud Firestore — Sprint #1
 * ============================================================
 * Publica este archivo en Firebase Console → Firestore Database → Rules.
 * (O mediante Firebase CLI: `firebase deploy --only firestore:rules`)
 *
 * Principios:
 *  - Cada usuario solo puede leer y escribir SU propio documento
 *    en la colección "usuarios" (documento id == uid del usuario).
 *  - Está prohibido almacenar contraseñas: el perfil solo contiene
 *    nombre, teléfono, correo y fecha de creación.
 *  - Las colecciones futuras (canchas, reservas) se añadirán en los
 *    próximos sprints con sus propias reglas.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil de usuario: uno por UID.
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Denegar todo lo demás por defecto (se ampliará en Sprint #2+).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
